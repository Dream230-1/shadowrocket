#!name=哔哩哔哩去广告 RC4.2 保守版
#!desc=仅处理已验证的开屏广告、视频页商业推荐和评论区推广；暂停信息流请求改写及动态、搜索、直播、播放 URL 等非必要处理，优先保护收藏、账号和播放功能。
#!author=Dream230-1 / LOWERTOP; upstream BiliUniverse contributors
#!homepage=https://github.com/Dream230-1/shadowrocket
#!category=LOWERTOP RC4
#!version=3.1.0-rc4.2
#!arguments=Splash:true,View.AD:true,Reply.AD:true,LogLevel:"WARN"
#!arguments-desc=保守模式。只过滤开屏、视频页商业推荐和评论区推广，不修改会员状态，不处理收藏、账号、动态、搜索、直播、弹幕或播放 URL。

# Upstream: BiliUniverse/ADBlock
# License: Apache-2.0

[Script]
# 开屏广告。仅处理明确的 splash JSON 接口。
📺 BiliBili.splash.response = type=http-response,pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/splash\/(brand\/list|event\/list2|list|show),requires-body=1,script-path=https://github.com/BiliUniverse/ADBlock/releases/latest/download/response.bundle.js,argument=Splash="{{{Splash}}}"&LogLevel="{{{LogLevel}}}"

# 视频详情及相关推荐商业卡片。包含 grpc.bilibili.com 与 grpc.biliapi.net。
📺 BiliBili.view.grpc = type=http-response,pattern=^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.(view|viewunite)\.v1\.View\/(View|TFInfo|RelatesFeed)$,requires-body=1,binary-body-mode=1,max-size=262144,script-path=https://github.com/BiliUniverse/ADBlock/releases/latest/download/response.bundle.js,argument=View.AD="{{{View.AD}}}"&LogLevel="{{{LogLevel}}}"

# 评论区广告及商业推荐链接。
📺 BiliBili.reply.grpc = type=http-response,pattern=^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.main\.community\.reply\.v1\.Reply\/MainList$,requires-body=1,binary-body-mode=1,max-size=262144,script-path=https://github.com/BiliUniverse/ADBlock/releases/latest/download/response.bundle.js,argument=Reply.AD="{{{Reply.AD}}}"&LogLevel="{{{LogLevel}}}"

[MITM]
hostname = %APPEND% app.bilibili.com,app.biliapi.net,grpc.bilibili.com,grpc.biliapi.net
h2 = true
