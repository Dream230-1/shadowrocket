name: GMOogway Daily Rules for Stash
desc: 将 reject、direct、proxy 拆分为低内存规则集；不指定 iCloud 缓存 path，避免多个 provider 并发创建目录导致 resource deadlock；proxy 指向 AI 策略组。

rule-providers:
  gmoogway-reject-domain:
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/Dream230-1/shadowrocket/release/v3.1.1/LOWERTOP-Enterprise-v3.1/rules/stash/gmoogway-reject-domain.yaml
    interval: 86400

  gmoogway-direct-domain:
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/Dream230-1/shadowrocket/release/v3.1.1/LOWERTOP-Enterprise-v3.1/rules/stash/gmoogway-direct-domain.yaml
    interval: 86400
  gmoogway-direct-classical:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/Dream230-1/shadowrocket/release/v3.1.1/LOWERTOP-Enterprise-v3.1/rules/stash/gmoogway-direct-classical.yaml
    interval: 86400

  gmoogway-proxy-domain:
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/Dream230-1/shadowrocket/release/v3.1.1/LOWERTOP-Enterprise-v3.1/rules/stash/gmoogway-proxy-domain.yaml
    interval: 86400
  gmoogway-proxy-ipcidr:
    behavior: ipcidr
    format: yaml
    url: https://raw.githubusercontent.com/Dream230-1/shadowrocket/release/v3.1.1/LOWERTOP-Enterprise-v3.1/rules/stash/gmoogway-proxy-ipcidr.yaml
    interval: 86400
  gmoogway-proxy-classical:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/Dream230-1/shadowrocket/release/v3.1.1/LOWERTOP-Enterprise-v3.1/rules/stash/gmoogway-proxy-classical.yaml
    interval: 86400

rules:
  - RULE-SET,gmoogway-reject-domain,REJECT
  - RULE-SET,gmoogway-direct-domain,DIRECT
  - RULE-SET,gmoogway-direct-classical,DIRECT
  - RULE-SET,gmoogway-proxy-domain,AI
  - RULE-SET,gmoogway-proxy-ipcidr,AI,no-resolve
  - RULE-SET,gmoogway-proxy-classical,AI
