name: GMOogway Daily Delta Rules for Stash

desc: 真正精简的每日增量版。先沿用主配置已有的 Direct、Reject、AI 规则，再加载 GMOogway 尚未被现有 22 个分类规则覆盖的增量 domain/ipcidr；通用代理交给 Global。要求主配置已定义 rule-provider Direct、Reject、AI，以及策略组 AI、Global。

rule-providers:
  gmoogway-lite-reject-domain:
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/Dream230-1/shadowrocket/release/v3.1.1/LOWERTOP-Enterprise-v3.1/rules/stash/gmoogway-lite-reject-domain.yaml
    interval: 86400

  gmoogway-lite-direct-domain:
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/Dream230-1/shadowrocket/release/v3.1.1/LOWERTOP-Enterprise-v3.1/rules/stash/gmoogway-lite-direct-domain.yaml
    interval: 86400

  gmoogway-lite-proxy-domain:
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/Dream230-1/shadowrocket/release/v3.1.1/LOWERTOP-Enterprise-v3.1/rules/stash/gmoogway-lite-proxy-domain.yaml
    interval: 86400

  gmoogway-lite-proxy-ipcidr:
    behavior: ipcidr
    format: yaml
    url: https://raw.githubusercontent.com/Dream230-1/shadowrocket/release/v3.1.1/LOWERTOP-Enterprise-v3.1/rules/stash/gmoogway-lite-proxy-ipcidr.yaml
    interval: 86400

rules:
  # 保持主配置分类权威；GMOogway 仅补充未覆盖规则。
  - RULE-SET,Direct,DIRECT
  - RULE-SET,Reject,REJECT
  - RULE-SET,gmoogway-lite-reject-domain,REJECT
  - RULE-SET,gmoogway-lite-direct-domain,DIRECT
  - RULE-SET,AI,AI
  - RULE-SET,gmoogway-lite-proxy-domain,Global
  - RULE-SET,gmoogway-lite-proxy-ipcidr,Global,no-resolve
