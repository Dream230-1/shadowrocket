#!date=2026-07-28

[Script]
# Bilibili 开屏
http-request ^https://app\.bilibili\.com/x/v2/splash/ script-path=https://raw.githubusercontent.com/Dream230-1/shadowrocket/release/v3.1-rc3/LOWERTOP-Enterprise-v3.1/scripts/mitm/bilibili_full.js, tag=Bili

# Bilibili 信息流
http-response ^https://app\.bilibili\.com/x/v2/feed/index\? requires-body=true, script-path=https://raw.githubusercontent.com/Dream230-1/shadowrocket/release/v3.1-rc3/LOWERTOP-Enterprise-v3.1/scripts/mitm/bilibili_full.js, tag=Bili

# 闲鱼
http-response ^https://market\.wapa\.taobao\.com/ requires-body=true, script-path=https://raw.githubusercontent.com/Dream230-1/shadowrocket/release/v3.1-rc3/LOWERTOP-Enterprise-v3.1/scripts/mitm/xianyu.js, tag=Xianyu

[MitM]
hostname = app.bilibili.com, market.wapa.taobao.com
