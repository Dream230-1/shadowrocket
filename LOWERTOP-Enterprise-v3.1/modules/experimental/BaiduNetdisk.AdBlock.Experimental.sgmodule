#!name=百度网盘去广告 RC4.2 Experimental
#!desc=保留精确接口去广告，并补充百度移动广告 SDK 域名拦截以处理开屏广告；不修改会员状态，不触碰登录、文件、上传下载、分享、转存及在线播放主链路。
#!author=Dream230-1 / LOWERTOP
#!homepage=https://github.com/Dream230-1/shadowrocket
#!category=LOWERTOP RC4 Experimental
#!version=3.1.0-rc4.2

# 仍属实验模块。出现登录、文件列表、下载或播放异常时立即禁用。

[Rule]
# 百度移动广告 SDK。用于补足 pan.baidu.com 接口未覆盖的开屏广告。
DOMAIN,mobads.baidu.com,REJECT
DOMAIN,afd.baidu.com,REJECT

[URL Rewrite]
# 开屏与客户端广告配置。
^https:\/\/pan\.baidu\.com\/api\/getconfig(?:\?|$) - reject-dict
^https:\/\/pan\.baidu\.com\/api\/getsyscfg(?:\?|$) - reject-dict
# 首页任务、积分与福利推广。
^https:\/\/pan\.baidu\.com\/api\/taskscore\/tasklist(?:\?|$) - reject-dict
^https:\/\/pan\.baidu\.com\/act\/api\/activityentry(?:\?|$) - reject-dict
^https:\/\/pan\.baidu\.com\/act\/v2\/welfare\/list(?:\?|$) - reject-dict
# 广告配置接口。
^https:\/\/pan\.baidu\.com\/rest\/\d\.\d\/pcs\/adv(?:\?|$) - reject-dict
# “我的”页面游戏中心，仅匹配 method=gamecenter。
^https:\/\/pan\.baidu\.com\/rest\/2\.0\/membership\/user\?(?=[^#]*\bmethod=gamecenter\b) - reject-dict

[MITM]
hostname = %APPEND% pan.baidu.com
